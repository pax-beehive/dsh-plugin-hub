# Cloudflare authentication
# Use a scoped API token, never the Global API Key.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Cloudflare resources owned by this account. The current production D1 binding
# is Sites-managed; do not assume these optional D1 fields identify that database.
CLOUDFLARE_ZONE_NAME=
CLOUDFLARE_PAGES_PROJECT_NAME=deepseek-plugin-hub
CLOUDFLARE_D1_DATABASE_NAME=deepseek-plugin-hub-waitlist
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_TURNSTILE_WIDGET_NAME=deepseek-plugin-hub-waitlist
CLOUDFLARE_PRODUCTION_DOMAIN=

# Cloudflare Email Service (server-side only)
CLOUDFLARE_EMAIL_API_TOKEN=
WAITLIST_FROM_EMAIL=hello@example.com
WAITLIST_FROM_NAME="DeepSeek Harness Plugin Hub"

# Waitlist form
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
WAITLIST_RATE_LIMIT_SALT=
WAITLIST_ADMIN_TOKEN=
WAITLIST_ALERT_MAX_FAILED_EMAILS=5
WAITLIST_ALERT_MAX_PENDING_EMAILS=10
WAITLIST_ALERT_TO_EMAIL=hello@dshpluginhub.ai
WAITLIST_ALLOWED_ORIGINS=http://localhost:5173
