# Cloudflare authentication
# Use a scoped API token, never the Global API Key.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Cloudflare resources owned by this account. The current production D1 binding
# is Sites-managed; do not assume these optional D1 fields identify that database.
CLOUDFLARE_ZONE_NAME=
CLOUDFLARE_PAGES_PROJECT_NAME=deepseek-plugin-hub
CLOUDFLARE_D1_DATABASE_NAME=deepseek-plugin-hub-waitlist
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_TURNSTILE_WIDGET_NAME=deepseek-plugin-hub-waitlist
CLOUDFLARE_PRODUCTION_DOMAIN=

# Cloudflare Email Service (server-side only)
CLOUDFLARE_EMAIL_API_TOKEN=
WAITLIST_FROM_EMAIL=hello@example.com
WAITLIST_FROM_NAME="DeepSeek Harness Plugin Hub"

# Waitlist form
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
WAITLIST_RATE_LIMIT_SALT=
# Dedicated salt for public npm sync submissions. The Worker can reuse
# WAITLIST_RATE_LIMIT_SALT for backward compatibility, but deployments should
# configure this independently.
NPM_SYNC_RATE_LIMIT_SALT=
WAITLIST_ADMIN_TOKEN=
WAITLIST_ALERT_MAX_FAILED_EMAILS=5
WAITLIST_ALERT_MAX_PENDING_EMAILS=10
WAITLIST_ALERT_TO_EMAIL=hello@dshpluginhub.ai
WAITLIST_ALLOWED_ORIGINS=http://localhost:5173

# WorkOS AuthKit (server-side except for the redirect URI)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:5173/callback

# GitHub App repository ownership flow
GITHUB_APP_ID=4631702
GITHUB_APP_SLUG=pax-dsh-hub
GITHUB_CLIENT_ID=Iv23liVukxgp1lfIaSI5
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_STATE_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_REDIRECT_URI=http://localhost:5173/integrations/github/oauth/callback

# GitHub topic discovery (optional). Without a token, discovery uses the
# unauthenticated search API (~10 requests/minute) and resumes across cron
# runs via persisted cursors. A read-only PAT raises the ceiling.
# NOTE: production architecture moved GitHub discovery to the Go backend;
# this var is only relevant to the legacy staging Worker cron.
GITHUB_TOKEN=

# Hub API (server-side only)
# Origin of the Hub API used by server components and the /api/* proxy.
# For local development, point it at a locally running Go backend
# (http://localhost:8080). Leave unset to let server components fall back to
# the same origin; the /api/* proxy returns 503 hub_api_not_configured when
# unset.
HUB_API_ORIGIN=
# Bearer token for the Hub API internal endpoints used by auth callbacks
# (identity upsert / GitHub installation save). Same value as the backend's
# INTERNAL_TASK_TOKEN.
HUB_INTERNAL_TOKEN=
