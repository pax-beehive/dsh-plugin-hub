{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deepseek-harness-plugin-hub",
  "account_id": "221784d24eb2a95d148bc96b6f06d6be",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/robots.txt", "/sitemap.xml", "/sitemap/*", "/status"]
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "HUB_API_ORIGIN": "https://api.dshpluginhub.ai",
    "WORKOS_CLIENT_ID": "client_01M09HAMW290EESBWR59D2EEAP",
    "NEXT_PUBLIC_WORKOS_REDIRECT_URI": "https://dshpluginhub.ai/callback",
    "GITHUB_APP_ID": "4631702",
    "GITHUB_APP_SLUG": "pax-dsh-hub",
    "GITHUB_REDIRECT_URI": "https://dshpluginhub.ai/integrations/github/oauth/callback",
    "NEXT_PUBLIC_GOOGLE_ADS_ID": "AW-18401737282",
    "NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_INSTALL": "FMLKCLGdoOUcEML00MZE",
    "NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_SIGNUP": "asRTCKnWo-UcEML00MZE"
  },
  "env": {
    "staging": {
      "name": "deepseek-harness-plugin-hub-staging",
      "account_id": "221784d24eb2a95d148bc96b6f06d6be",
      "routes": [
        {
          "pattern": "staging.dshpluginhub.ai",
          "custom_domain": true
        }
      ],
      "vars": {
        "HUB_API_ORIGIN": "https://api.dshpluginhub.ai",
        "WORKOS_CLIENT_ID": "client_01M09HAMFBJJ6T8M0ZYY69M9HP",
        "NEXT_PUBLIC_WORKOS_REDIRECT_URI": "https://staging.dshpluginhub.ai/callback",
        "GITHUB_APP_ID": "4631702",
        "GITHUB_APP_SLUG": "pax-dsh-hub",
        "GITHUB_CLIENT_ID": "Iv23liVukxgp1lfIaSI5",
        "GITHUB_REDIRECT_URI": "https://staging.dshpluginhub.ai/integrations/github/oauth/callback"
      }
    }
  }
}
